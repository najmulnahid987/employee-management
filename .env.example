# Dispatcher Client Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# NOTE: .env, .env.local, and all .env.* files (except .env.example) are git-ignored.

# -----------------------------------------------------------------------------
# Supabase Configuration (Future Backend Integration)
# -----------------------------------------------------------------------------
# The URL of your Supabase project instance (e.g., https://your-project.supabase.co)
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# The Supabase anonymous/publishable client key safe for client-side mobile exposure.
# Used for client authentication and queries governed by Row Level Security (RLS).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"

# -----------------------------------------------------------------------------
# Google Maps Configuration (Android Native Maps SDK)
# -----------------------------------------------------------------------------
# Used on Android native builds for the Owner Live Map (expo-maps).
# The key must be restricted in Google Cloud Console:
# 1. API restrictions: "Maps SDK for Android" ONLY.
# 2. Application restrictions: Android apps with package "com.dispatcher.mobile"
#    and your development / release keystore SHA-1 certificate fingerprint.
# Leave empty on iOS (uses native Apple Maps without API keys) or web.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="your-restricted-google-maps-android-api-key"

# -----------------------------------------------------------------------------
# Expo Application Services (EAS) Configuration (Phase M15 Notifications)
# -----------------------------------------------------------------------------
# Required on physical native builds for push notification token acquisition.
# Retrieved from your Expo project dashboard or via 'npx eas project:init'.
# Leave empty during local simulator development.
EXPO_PUBLIC_EAS_PROJECT_ID=""

# -----------------------------------------------------------------------------
# CRITICAL SECURITY NOTICE:
# -----------------------------------------------------------------------------
# NEVER add service-role keys (SUPABASE_SERVICE_ROLE_KEY), database passwords,
# or private server secrets to this file or any EXPO_PUBLIC_* variable.
# All EXPO_PUBLIC_* variables are bundled directly into client mobile application
# binaries and are accessible to end users and reverse engineering.
